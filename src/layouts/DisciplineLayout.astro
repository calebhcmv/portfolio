---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Eyebrow from '../components/typography/Eyebrow.astro';
import ProjectIndex from '../components/projects/ProjectIndex.astro';
import { getDiscipline, profile } from '../content/profile';
import { projectsByCategory, type ProjectCategory } from '../content/projects';

type Props = { id: ProjectCategory };

const discipline = getDiscipline(Astro.props.id);
const list = projectsByCategory(discipline.id);
const others = profile.disciplines.filter((d) => d.id !== discipline.id);
const index = String(profile.disciplines.indexOf(discipline) + 1).padStart(2, '0');
---

<BaseLayout title={`${discipline.title} — ${profile.name}`} description={discipline.intro}>
  <PageIntro eyebrow={`Discipline ${index}`} title={discipline.title} intro={discipline.intro} />

  <section aria-labelledby="projects-title" class="pb-section">
    <Container>
      <div class="grid-editorial mb-xl">
        <Eyebrow as="h2" id="projects-title" class="col-span-full">Projects</Eyebrow>
      </div>
      <ProjectIndex
        projects={list}
        showCategory={false}
        empty={`No ${discipline.title.toLowerCase()} projects are published yet. They will appear here once documented with context, process and evidence.`}
      />
    </Container>
  </section>

  <nav aria-labelledby="other-title" class="pb-section">
    <Container>
      <div class="grid-editorial mb-xl">
        <Eyebrow as="h2" id="other-title" class="col-span-full">Other disciplines</Eyebrow>
      </div>
      <ul class="m-0 list-none border-t border-border p-0">
        {
          others.map((d) => (
            <li class="border-b border-border">
              <a href={d.href} class="group grid-editorial items-baseline py-lg">
                <span class="type-h2 col-span-4 group-hover:underline group-focus-visible:underline decoration-1 underline-offset-[0.15em] md:col-span-6 lg:col-span-12">
                  {d.title}
                </span>
                <span class="type-nav col-span-4 text-secondary md:col-span-2 md:text-right lg:col-span-4" aria-hidden="true">
                  View →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </nav>
</BaseLayout>
