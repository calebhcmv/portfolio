---
import { profile } from '../../content/profile';
import Container from './Container.astro';

const navItems = [
  { label: 'Work', href: '/#work', match: (p: string) => p.startsWith('/projects') },
  { label: 'About', href: '/about', match: (p: string) => p === '/about' },
  { label: 'Contact', href: '/contact', match: (p: string) => p === '/contact' },
];

const path = Astro.url.pathname.replace(/(index)?(\.html)?\/?$/, '') || '/';
---

<header class="relative z-10">
  <a
    href="#main"
    class="type-nav sr-only focus:not-sr-only focus:absolute focus:left-gutter focus:top-sm focus:bg-primary focus:px-sm focus:py-xs focus:text-background"
  >
    Skip to content
  </a>
  <Container class="grid-editorial items-baseline py-md lg:py-lg">
    <a
      href="/"
      class="type-nav link-editorial col-span-2 justify-self-start md:col-span-4 lg:col-span-8"
      aria-current={path === '/' ? 'page' : undefined}
    >
      {profile.name}
    </a>
    <nav aria-label="Primary" class="col-span-2 justify-self-end md:col-span-4 lg:col-span-8">
      <ul class="type-nav m-0 flex list-none gap-md p-0 md:gap-lg">
        {
          navItems.map((item) => {
            const current = item.match(path);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'link-editorial hover:text-primary focus-visible:text-primary',
                    current ? 'text-primary' : 'text-secondary',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>
